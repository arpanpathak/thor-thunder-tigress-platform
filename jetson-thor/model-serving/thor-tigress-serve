#!/usr/bin/env python3
"""Serves models and the chat page on the Jetson Thor, on localhost only.

Every model is served by TensorRT Edge-LLM, one engine and one service each.

Models:
  thor-tigress-serve list                  the models on this Thor, each with a key
  thor-tigress-serve load KEY|NAME         start a model's engine
  thor-tigress-serve unload KEY|NAME       stop it and free its memory

Services:
  thor-tigress-serve install               run the engines and the chat page as
                                           services, started at boot
  thor-tigress-serve uninstall             stop and remove them
  thor-tigress-serve key                   create a new access key
  thor-tigress-serve keyring-init          make the encrypted keyring and its passphrase
  thor-tigress-serve keyring CMD ...       run thor-tigress-keyring on that keyring
  thor-tigress-serve logs                  follow the logs

The services run "thor-tigress-serve edge [NAME]", one per model, and
"thor-tigress-serve agent" (thor-tigress-agent: the page and API on :8080).
Settings go in ~/.config/thor-chat/env as KEY=value lines:

  EDGE_MODEL    the first model's checkpoint folder      none
  EDGE_PORT     its engine's port                        8081
  EDGE_CONTEXT  its tokens per reply                     32768
  EDGE_MODELS   more models, FOLDER=PORT[:TOKENS]        none
  EDGE_PROMPT   the longest single prompt                half a model's tokens
  MIN_FREE_GB   memory kept free                         8
  PORT, SEARCH_PORT                                      8080, 8888

The agent is given one --engine per model, EDGE_MODEL first. A request naming a
model (its folder's name) goes to that model's engine; a request naming
anything else, or nothing, goes to the first. That is what lets a coding tool
that sends its own model name be answered.

Adding a model is two steps; its checkpoint folder must sit next to
EDGE_MODEL's, under ~/models/edge-llm:

  echo 'EDGE_MODELS=NVIDIA-Nemotron-3.5-Lightning-30B-A3B-NVFP4=8082:1048576' >> ~/.config/thor-chat/env
  thor-tigress-serve install

The first start of a model builds its engine; later ones reuse the cache.
"""

import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config" / "thor-chat"
HERE = Path(__file__).resolve().parent
WEB = HERE.parent / "web"
UNITS = HOME / ".config" / "systemd" / "user"

# One engine's unit holds the checkpoint it builds from, its weights, and the build's
# GPU buffers at the same time. 48G killed a 30B NVFP4 build in a restart loop.
EDGE_LIMITS = "MemoryMax=80G\nMemorySwapMax=0\n"

# Units earlier versions installed and this one must take away: llama-server in
# router mode, which loaded a model again on any request that named it.
RETIRED_UNITS = ("thor-chat",)

# (text in the model's name, reasoning parser, tool-call parser). These are the
# pairs the two served models were measured with; any other model gets "auto".
PARSERS = (
    ("qwen", "qwen3", "qwen3_xml"),
    ("nemotron", "nemotron", "nemotron"),
)

DEFAULTS = {
    "EDGE_MODEL": "",
    "EDGE_PORT": "8081",
    "EDGE_CONTEXT": "32768",
    "EDGE_PROMPT": "",
    "EDGE_MODELS": "",
    "EDGE_SERVER": str(HOME / ".local" / "share" / "edge-llm" / "venv" / "bin" / "tensorrt-edgellm-serve"),
    "MIN_FREE_GB": "8",
    "PORT": "8080",
    "SEARCH_PORT": "8888",
    "AGENT": str(HOME / ".cargo" / "bin" / "thor-tigress-agent"),
    "KEYRING_BIN": str(HOME / ".cargo" / "bin" / "thor-tigress-keyring"),
    "KEYRING": str(CONFIG / "keyring"),
    "KEYRING_PASSPHRASE": str(CONFIG / "keyring-passphrase"),
}

WORKING_GB = 2


def settings():
    """The defaults, overridden by ~/.config/thor-chat/env, then by the environment."""
    values = dict(DEFAULTS)
    env = CONFIG / "env"
    if env.exists():
        for line in env.read_text().splitlines():
            key, sep, value = line.strip().partition("=")
            if sep and not key.startswith("#"):
                values[key.strip()] = os.path.expanduser(os.path.expandvars(value.strip().strip("\"'")))
    values.update({key: os.environ[key] for key in DEFAULTS if key in os.environ})
    return values


def gb(size):
    return f"{size / 1e9:.1f} GB"


def free_gb():
    for line in Path("/proc/meminfo").read_text().splitlines():
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) / 1024 / 1024
    return 0.0


def total_gb():
    return int(Path("/proc/meminfo").read_text().split()[1]) / 1024 / 1024


# ---- the models ----

def edge_root(values):
    """Where the TensorRT Edge-LLM checkpoints live: beside EDGE_MODEL, else ~/models/edge-llm."""
    if values["EDGE_MODEL"]:
        return Path(values["EDGE_MODEL"]).parent
    return HOME / "models" / "edge-llm"


def edge_models(values):
    """Every model: the one EDGE_MODEL names, then the ones EDGE_MODELS adds.

    EDGE_MODELS is a comma- or space-separated list of FOLDER=PORT or FOLDER=PORT:TOKENS, each
    FOLDER under the same directory as EDGE_MODEL. TOKENS is that model's own context window,
    because one number cannot fit every model: Nemotron 3.5 Lightning spends 3.5 KiB of cache
    per token at 1M tokens while Qwen3.6 35B spends 80 KiB, so the same window would ask Qwen
    for 80 GB. Without TOKENS the model gets EDGE_CONTEXT. A folder's name is what the chat
    page's picker shows and what a request names."""
    found = []
    if values["EDGE_MODEL"]:
        path = Path(values["EDGE_MODEL"])
        found.append({"name": path.name, "path": path, "port": values["EDGE_PORT"],
                      "context": values["EDGE_CONTEXT"], "primary": True})
    for entry in values["EDGE_MODELS"].replace(",", " ").split():
        folder, separator, rest = entry.partition("=")
        port, _, tokens = rest.partition(":")
        if not separator or not folder or not port:
            sys.exit(f"EDGE_MODELS {entry!r}: expected FOLDER=PORT or FOLDER=PORT:TOKENS")
        found.append({"name": folder, "path": edge_root(values) / folder, "port": port,
                      "context": tokens or values["EDGE_CONTEXT"], "primary": False})
    return found


def edge_unit(entry):
    """The service that serves one model: thor-edge-llm for EDGE_MODEL, thor-edge-llm-<name> for the others."""
    if entry["primary"]:
        return "thor-edge-llm"
    return "thor-edge-llm-" + re.sub(r"[^a-z0-9]+", "-", entry["name"].lower()).strip("-")


def edge_prompt(entry, values):
    """The longest single prompt this engine takes: EDGE_PROMPT when it is set, never more
    than half the model's window, because the rest of the window has to hold the answer.

    The window and the longest prompt are separate costs. The KV cache is small (Lightning
    spends 3 GB on a million tokens) while the activation buffers an engine reserves for its
    longest prompt are not: half a window of 1M asked for ~45 GB of them and took the whole
    board down. A capped prompt keeps the million-token window and gives the memory back."""
    half = int(entry["context"]) // 2
    wanted = values["EDGE_PROMPT"]
    if not wanted:
        return half
    return min(int(wanted), half)


def edge_parsers(name):
    """The reasoning and tool-call parsers for a model, by its family."""
    lowered = name.lower()
    for family, reasoning, tool_call in PARSERS:
        if family in lowered:
            return reasoning, tool_call
    return "auto", "auto"


def edge_command(entry, values):
    """The command line of one model's engine."""
    reasoning, tool_call = edge_parsers(entry["name"])
    return [values["EDGE_SERVER"], str(entry["path"]), "--host", "127.0.0.1",
            "--port", entry["port"], "--served-model-name", entry["name"],
            "--reasoning-parser", reasoning,
            "--tool-call-parser", tool_call, "--enable-auto-tool-choice",
            "--cache-dir", str(edge_root(values) / "cache"),
            "--max-input-len", str(edge_prompt(entry, values)),
            "--max-kv-cache-capacity", str(entry["context"]),
            "--max-batch-size", "1"]


def agent_command(values):
    """The command line of the page and API: one --engine per model, EDGE_MODEL first,
    which makes it the one that answers a request naming no model here."""
    entries = edge_models(values)
    if not entries:
        sys.exit("no model to serve: set EDGE_MODEL in ~/.config/thor-chat/env")
    engines = [item for entry in entries
               for item in ("--engine", f"{entry['name']}=127.0.0.1:{entry['port']}")]
    return [values["AGENT"], "--listen", f"127.0.0.1:{values['PORT']}", *engines,
            "--search", f"127.0.0.1:{values['SEARCH_PORT']}",
            "--web", str(WEB), "--key-file", str(CONFIG / "api-key"),
            *keyring_arguments(values)]


# ---- the list ----

def edge_answering(port):
    """Whether the engine on `port` answers."""
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{port}/v1/models", timeout=5):
            return True
    except (urllib.error.URLError, TimeoutError, ConnectionError):
        return False


def rows(values):
    """The models on this Thor: loaded while its engine answers."""
    found = []
    for entry in edge_models(values):
        size = sum(path.stat().st_size for path in entry["path"].glob("*.safetensors"))
        found.append({"id": entry["name"], "state": "loaded" if edge_answering(entry["port"]) else "on disk",
                      "size": size, "unit": edge_unit(entry), "port": entry["port"],
                      "context": int(entry["context"]), "prompt": edge_prompt(entry, values)})
    return found


def list_here(values):
    print(f"\nThor: {free_gb():.1f} GB free of {total_gb():.1f} GB · keeps {values['MIN_FREE_GB']} GB free\n")
    print(f"  {'key':<4} {'model':<46} {'state':<9} {'size':>9}  {'port':<5} context · longest prompt")
    for key, row in enumerate(rows(values), 1):
        print(f"  {key:<4} {row['id'][:46]:<46} {row['state']:<9} {gb(row['size']):>9}  {row['port']:<5}"
              f" {row['context'] // 1024}K · {row['prompt'] // 1024}K")
    print()


def find(values, wanted):
    """The row a key ("2") or a name points to."""
    found = rows(values)
    if wanted.isdigit() and 1 <= int(wanted) <= len(found):
        return found[int(wanted) - 1]
    for row in found:
        if wanted.lower() == row["id"].lower():
            return row
    sys.exit(f"no model {wanted!r}; see thor-tigress-serve list")


def load(values, wanted):
    """Starts a model's engine and waits until it answers, stopping it again if free
    memory falls below MIN_FREE_GB."""
    row = find(values, wanted)
    if row["state"] == "loaded":
        return print("already loaded")
    minimum, unit_name = int(values["MIN_FREE_GB"]), row["unit"]
    needed, room = row["size"] / 1e9 + WORKING_GB, max(0.0, free_gb() - minimum)
    if needed > room:
        return print(f"not loaded: needs about {needed:.0f} GB, only {room:.0f} GB can be used"
                     f" while keeping {minimum} GB free")
    before, started = free_gb(), time.time()
    subprocess.run(["systemctl", "--user", "start", unit_name], check=True)
    while not edge_answering(row["port"]):
        if free_gb() < minimum:
            subprocess.run(["systemctl", "--user", "stop", unit_name], check=False)
            return print(f"free memory fell below {minimum} GB while loading; stopped again")
        if subprocess.run(["systemctl", "--user", "is-failed", "-q", unit_name]).returncode == 0:
            return print(f"failed to start; see: journalctl --user -u {unit_name} -n 50")
        time.sleep(2)
    return print(f"loaded in {time.time() - started:.0f} s: {before - free_gb():.1f} GB used, {free_gb():.1f} GB free")


def unload(values, wanted):
    """Stops a model's engine. It stays in the settings, so it starts again at boot."""
    row = find(values, wanted)
    if row["state"] == "on disk":
        return print("not loaded")
    before = free_gb()
    subprocess.run(["systemctl", "--user", "stop", row["unit"]], check=True)
    time.sleep(3)
    return print(f"unloaded: {free_gb() - before:.1f} GB freed, {free_gb():.1f} GB free")


# ---- services ----

def edge(values, wanted=None):
    """The engine for one model: EDGE_MODEL when NAME is left out, else the EDGE_MODELS
    entry with that folder name. It builds the engine the first time."""
    entry = next((item for item in edge_models(values)
                  if (item["primary"] if wanted is None else item["name"] == wanted)), None)
    if entry is None:
        sys.exit(f"no Edge-LLM model {wanted!r} in EDGE_MODELS" if wanted else "set EDGE_MODEL to a checkpoint folder")
    command = edge_command(entry, values)
    os.execv(command[0], command)


def agent(values):
    command = agent_command(values)
    os.execv(command[0], command)


def keyring_arguments(values):
    """--keyring and its passphrase, only when both are there, so the agent starts either way."""
    keyring_file = Path(values["KEYRING"])
    passphrase = Path(values["KEYRING_PASSPHRASE"])
    if keyring_file.exists() and passphrase.exists():
        return ["--keyring", str(keyring_file), "--keyring-passphrase-file", str(passphrase)]
    return []


def unit(name, description, command, after, limits=""):
    (UNITS / f"{name}.service").write_text(f"""[Unit]
Description={description}
After=network-online.target {after}

[Service]
ExecStart={Path(__file__).resolve()} {command}
Restart=on-failure
RestartSec=5
{limits}
[Install]
WantedBy=default.target
""")


def install(values):
    """Writes one unit per model and one for the page, and starts them. A unit this
    install no longer wants is stopped and removed first, because it still holds the
    port it was given, and the symlink on the PATH is pointed at this file."""
    entries = edge_models(values)
    if not entries:
        sys.exit("no model to serve: set EDGE_MODEL in ~/.config/thor-chat/env")
    UNITS.mkdir(parents=True, exist_ok=True)
    engines = [edge_unit(entry) for entry in entries]
    for entry, name in zip(entries, engines):
        unit(name, f"{entry['name']} (TensorRT Edge-LLM) on 127.0.0.1:{entry['port']}",
             "edge" if entry["primary"] else f"edge {entry['name']}", "", EDGE_LIMITS)
    unit("thor-tigress-agent", f"Chat page and web search on 127.0.0.1:{values['PORT']}", "agent",
         " ".join(f"{name}.service" for name in engines))
    services = [*engines, "thor-tigress-agent"]
    source = Path(__file__).resolve()
    command = HOME / ".local" / "bin" / "thor-tigress-serve"
    command.parent.mkdir(parents=True, exist_ok=True)
    if source != command:
        command.unlink(missing_ok=True)
        command.symlink_to(source)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    for name in drop_units(stale_units(services)):
        print(f"removed {name}: this install does not run it")
    subprocess.run(["systemctl", "--user", "enable", *services], check=True, capture_output=True)
    subprocess.run(["systemctl", "--user", "restart", *services], check=True)
    subprocess.run(["loginctl", "enable-linger", os.environ.get("USER", "")], check=False)
    print(f"running: http://127.0.0.1:{values['PORT']}")
    for entry in entries:
        print(f"  {entry['name']} (TensorRT Edge-LLM) on 127.0.0.1:{entry['port']}"
              f" (service {edge_unit(entry)})")


def installed_units():
    """Every unit this script has ever written that is on disk, by name."""
    names = [path.stem for path in sorted(UNITS.glob("thor-edge-llm*.service"))]
    return names + [name for name in (*RETIRED_UNITS, "thor-tigress-agent") if (UNITS / f"{name}.service").exists()]


def stale_units(wanted):
    """The installed units that are not in `wanted`: engines an earlier EDGE_MODELS
    left behind, and the retired llama-server unit."""
    return [name for name in installed_units() if name not in wanted]


def drop_units(names):
    """Stops and deletes units, with the drop-ins they carry."""
    if not names:
        return names
    subprocess.run(["systemctl", "--user", "disable", "--now", *names], check=False)
    for name in names:
        (UNITS / f"{name}.service").unlink(missing_ok=True)
        shutil.rmtree(UNITS / f"{name}.service.d", ignore_errors=True)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    return names


def uninstall(values):
    """Stops and removes every service, the retired ones too."""
    drop_units(installed_units())
    print("stopped and removed")


def key(values):
    CONFIG.mkdir(parents=True, exist_ok=True)
    path = CONFIG / "api-key"
    path.write_text(os.urandom(24).hex() + "\n")
    path.chmod(0o600)
    print(f"new key written to {path}\napply it: systemctl --user restart thor-tigress-agent")


def keyring_init(values):
    """Makes the encrypted keyring and the passphrase the agent reads; both mode 600."""
    CONFIG.mkdir(parents=True, exist_ok=True)
    if Path(values["KEYRING"]).exists():
        print(f"{values['KEYRING']} is already there; use \"keyring keys\" to see who is in it")
        return
    passphrase = Path(values["KEYRING_PASSPHRASE"])
    if not passphrase.exists():
        passphrase.write_text(os.urandom(24).hex() + "\n")
        passphrase.chmod(0o600)
    subprocess.run([values["KEYRING_BIN"], "--keyring", values["KEYRING"],
                    "--passphrase-file", str(passphrase), "init"], check=True)
    print(f"keyring at {values['KEYRING']}\n"
          "people ask on the invite screen, then: thor-tigress-serve keyring requests\n"
          "approve one with: thor-tigress-serve keyring approve EMAIL\n"
          "apply it: systemctl --user restart thor-tigress-agent")


def keyring(values, rest):
    """Runs thor-tigress-keyring on the keyring these services use."""
    if not Path(values["KEYRING"]).exists():
        sys.exit("no keyring yet; run: thor-tigress-serve keyring-init")
    command = [values["KEYRING_BIN"], "--keyring", values["KEYRING"],
               "--passphrase-file", values["KEYRING_PASSPHRASE"]]
    os.execv(values["KEYRING_BIN"], command + rest)


def logs(values):
    """Follows the services: each engine, and the page."""
    units = [*(edge_unit(entry) for entry in edge_models(values)), "thor-tigress-agent"]
    arguments = [item for name in units for item in ("-u", name)]
    os.execvp("journalctl", ["journalctl", "--user", *arguments, "-f"])


COMMANDS = {
    "list": list_here, "install": install, "uninstall": uninstall, "key": key,
    "keyring-init": keyring_init, "logs": logs, "agent": agent,
}
COMMANDS_WITH_NAME = {"load": load, "unload": unload}


def main():
    values = settings()
    command, *rest = sys.argv[1:] or ["help"]
    if command == "keyring":
        return keyring(values, rest)
    if command == "edge" and len(rest) <= 1:
        return edge(values, rest[0] if rest else None)
    if command in COMMANDS and not rest:
        return COMMANDS[command](values)
    if command in COMMANDS_WITH_NAME and len(rest) == 1:
        return COMMANDS_WITH_NAME[command](values, rest[0])
    print(__doc__)
    return None if command in ("help", "-h", "--help") else sys.exit(2)


if __name__ == "__main__":
    main()
