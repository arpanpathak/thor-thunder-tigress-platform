#!/usr/bin/env python3
"""Serves models and the chat page on the Jetson Thor, on localhost only.

Models:
  thor-tigress-serve list                  the models on this Thor, each with a key
  thor-tigress-serve list-latest           the newest chat models on Hugging Face that
                                           fit, each with a key
  thor-tigress-serve load KEY|NAME         load a model from "list"
  thor-tigress-serve unload KEY|NAME       unload it
  thor-tigress-serve download KEY|REPO     download a model from "list-latest"

Services:
  thor-tigress-serve install               run the model server and the chat page as
                                           services, started at boot
  thor-tigress-serve uninstall             stop and remove both services
  thor-tigress-serve key                   create a new access key
  thor-tigress-serve logs                  follow both logs

The services run "thor-tigress-serve run" (llama-server in router mode on
:8079) and "thor-tigress-serve agent" (thor-tigress-agent: the page and API
on :8080). Settings go in ~/.config/thor-chat/env as KEY=value lines:

  MODEL         the default model's GGUF   Nemotron 3 Nano 30B-A3B Q8_0
  USERS         its replies at once        4
  CONTEXT       its tokens per reply       1048576
  MODELS_MAX    models loaded at once      2
  MIN_FREE_GB   memory kept free           8
  PORT, MODEL_PORT, SEARCH_PORT            8080, 8079, 8888
"""

import concurrent.futures
import json
import os
import re
import subprocess
import sys
import time
import urllib.error
import urllib.request
from pathlib import Path

HOME = Path.home()
CONFIG = HOME / ".config" / "thor-chat"
MODELS_DIR = HOME / "models" / "gguf"
HERE = Path(__file__).resolve().parent
WEB = HERE.parent / "web"
UNITS = HOME / ".config" / "systemd" / "user"
LATEST = HOME / ".cache" / "thor-tigress-serve" / "latest.json"
LLAMA = HOME / ".local" / "src" / "llama.cpp"

DEFAULTS = {
    "MODEL": str(MODELS_DIR / "Nemotron-3-Nano-30B-A3B" / "NVIDIA-Nemotron-3-Nano-30B-A3B-Q8_0.gguf"),
    "USERS": "4",
    "CONTEXT": "1048576",
    "MODELS_MAX": "2",
    "MIN_FREE_GB": "8",
    "PORT": "8080",
    "MODEL_PORT": "8079",
    "SEARCH_PORT": "8888",
    "SERVER": str(LLAMA / "build" / "bin" / "llama-server"),
    "AGENT": str(HOME / ".cargo" / "bin" / "thor-tigress-agent"),
}

TRY_CONTEXT = 65536
WORKING_GB = 2
SYSTEM_GB = 5
QUANTS = ["Q8_0", "Q6_K", "Q5_K_M", "Q4_K_M", "MXFP4"]
CHAT_TAGS = {"text-generation", "image-text-to-text"}
PUBLISHERS = ["unsloth", "ggml-org"]
PART = re.compile(r"-0000[2-9]-of-|-000[1-9]\d-of-")
HELPER = re.compile(r"(^|/)(mtp|dflash|dspark|draft|eagle|mmproj|shard_rewrite)[-_./]", re.I)


def settings():
    """The defaults, overridden by ~/.config/thor-chat/env, then by the environment."""
    values = dict(DEFAULTS)
    env = CONFIG / "env"
    if env.exists():
        for line in env.read_text().splitlines():
            key, sep, value = line.strip().partition("=")
            if sep and not key.startswith("#"):
                values[key.strip()] = os.path.expanduser(os.path.expandvars(value.strip().strip("\"'")))
    values.update({key: os.environ[key] for key in DEFAULTS if key in os.environ})
    return values


def model_id(path):
    """The id a GGUF file is listed under: its name without .gguf or a part suffix."""
    return re.sub(r"-00001-of-\d+$", "", Path(path).name.removesuffix(".gguf"))


def label(name):
    """A readable name: "NVIDIA-Nemotron-3-Nano-30B-A3B-Q8_0" -> "Nemotron 3 Nano 30B A3B · Q8_0"."""
    name = re.sub(r"^NVIDIA-", "", name)
    name = re.sub(r"-((?:UD-)?(?:I?Q\d\w*|MXFP4\w*|BF16|F16))$", r" · \1", name, flags=re.I)
    return name.replace("-", " ")


def gb(size):
    return f"{size / 1e9:.1f} GB"


def free_gb():
    for line in Path("/proc/meminfo").read_text().splitlines():
        if line.startswith("MemAvailable:"):
            return int(line.split()[1]) / 1024 / 1024
    return 0.0


def total_gb():
    return int(Path("/proc/meminfo").read_text().split()[1]) / 1024 / 1024


# ---- presets ----

def local_sections():
    """The sections of models added from disk, as {id: text}."""
    path = CONFIG / "models.local.ini"
    if not path.exists():
        return {}
    sections = re.split(r"(?m)^(?=\[)", path.read_text())
    return {re.match(r"\[([^\]]+)\]", text).group(1): text.strip() for text in sections if text.startswith("[")}


def presets(values):
    """models.ini: shared options, the default model, then the models added from disk."""
    model = values["MODEL"]
    users = int(values["USERS"])
    default = "\n".join([
        "version = 1",
        "",
        "[*]",
        "n-gpu-layers = 999",
        "flash-attn = on",
        "jinja = true",
        "load-on-startup = true",
        "",
        f"[{model_id(model)}]",
        f"model = {model}",
        f"alias = nemotron,nemotron-think,{model}",
        f"parallel = {users}",
        f"ctx-size = {int(values['CONTEXT']) * users}",
    ])
    return "\n\n".join([default, *local_sections().values()]) + "\n"


def remove_from_list(name):
    """Takes a model added from disk off the list; its file stays."""
    sections = local_sections()
    sections.pop(name, None)
    path = CONFIG / "models.local.ini"
    if sections:
        path.write_text("\n\n".join(sections.values()) + "\n")
    else:
        path.unlink(missing_ok=True)


def add_from_disk(path):
    """Lists a GGUF on disk with one reply at a time and a 64K context, not loaded at start."""
    sections = local_sections()
    sections[model_id(path)] = "\n".join([
        f"[{model_id(path)}]",
        f"model = {path}",
        "parallel = 1",
        f"ctx-size = {TRY_CONTEXT}",
        "load-on-startup = false",
    ])
    (CONFIG / "models.local.ini").write_text("\n\n".join(sections.values()) + "\n")


# ---- the router ----

class Router:
    """llama-server in router mode on localhost, called with the access key."""

    def __init__(self, values):
        self.base = f"http://127.0.0.1:{values['MODEL_PORT']}"
        key = CONFIG / "api-key"
        self.key = key.read_text().strip() if key.exists() else ""

    def call(self, method, path, body=None, timeout=30):
        request = urllib.request.Request(self.base + path, method=method,
                                         data=json.dumps(body).encode() if body is not None else None)
        request.add_header("Content-Type", "application/json")
        if self.key:
            request.add_header("Authorization", f"Bearer {self.key}")
        with urllib.request.urlopen(request, timeout=timeout) as response:
            return json.load(response)

    def models(self, reload=False):
        """{id: state}, where state is loaded, loading, unloaded or failed."""
        listing = self.call("GET", "/models?reload=1" if reload else "/models")["data"]
        return {model["id"]: "failed" if model["status"].get("failed") else model["status"]["value"] for model in listing}

    def reload(self, values):
        (CONFIG / "models.ini").write_text(presets(values))
        return self.models(reload=True)


# ---- what can be picked ----

def on_disk():
    """Every GGUF under ~/models/gguf, one entry per model (first part only)."""
    files = sorted(path for path in MODELS_DIR.rglob("*.gguf") if not HELPER.search(path.name) and not PART.search(path.name))
    return {model_id(path): path for path in files}


def size_of(path):
    """The size of a model, all parts together."""
    path = Path(path)
    if "-00001-of-" not in path.name:
        return path.stat().st_size
    stem = path.name.split("-00001-of-")[0]
    return sum(part.stat().st_size for part in path.parent.glob(f"{stem}-000*-of-*.gguf"))


def known_architectures():
    source = LLAMA / "src" / "llama-arch.cpp"
    return set(re.findall(r'\{\s*LLM_ARCH_\w+,\s*"([^"]+)"\s*\}', source.read_text())) if source.exists() else set()


def hugging_face(path):
    with urllib.request.urlopen("https://huggingface.co/api/" + path, timeout=30) as response:
        return json.load(response)


def best_quant(repo, room):
    """The best quant of a repository that fits in `room` bytes, else the smallest one: (name, files, size)."""
    files = [item for item in hugging_face(f"models/{repo}/tree/main?recursive=true")
             if item["type"] == "file" and item["path"].endswith(".gguf") and not HELPER.search(item["path"])]
    found = []
    for quant in QUANTS:
        chosen = [item for item in files if re.search(rf"(?<![A-Z\d]){quant}(?:_XL)?(?=[.-])", Path(item["path"]).name)]
        unsplit = [item for item in chosen if "-of-" not in item["path"]]
        if unsplit:
            chosen = [min(unsplit, key=lambda item: item["size"])]
        if chosen:
            found.append((quant, [item["path"] for item in chosen], sum(item["size"] for item in chosen)))
    fitting = [entry for entry in found if entry[2] <= room]
    return fitting[0] if fitting else (min(found, key=lambda entry: entry[2]) if found else None)


def latest(values, count=12):
    """The newest chat models from unsloth and ggml-org that llama.cpp here can run and that fit alone."""
    architectures = known_architectures()
    alone = (total_gb() - SYSTEM_GB - int(values["MIN_FREE_GB"]) - WORKING_GB) * 1e9
    room_now = (free_gb() - int(values["MIN_FREE_GB"]) - WORKING_GB) * 1e9
    repos, seen = [], set()
    for publisher in PUBLISHERS:
        for repo in hugging_face(f"models?author={publisher}&filter=gguf&sort=createdAt&direction=-1&limit=40"
                                 "&expand[]=gguf&expand[]=createdAt&expand[]=pipeline_tag&expand[]=tags"):
            gguf = repo.get("gguf") or {}
            name = repo["id"].split("/")[1].removesuffix("-GGUF").lower()
            if (repo.get("pipeline_tag") in CHAT_TAGS and gguf.get("architecture") in architectures
                    and (gguf.get("total") or 0) >= 1e9 and name not in seen):
                seen.add(name)
                repos.append(repo)
    repos.sort(key=lambda repo: repo.get("createdAt", ""), reverse=True)
    with concurrent.futures.ThreadPoolExecutor(8) as pool:
        quants = list(pool.map(lambda repo: best_quant(repo["id"], room_now), repos))
    picks = []
    for repo, quant in zip(repos, quants):
        if quant and quant[2] <= alone:
            licence = next((tag[8:] for tag in repo.get("tags", []) if tag.startswith("license:")), "?")
            picks.append({"repo": repo["id"], "date": repo.get("createdAt", "")[:10], "licence": licence,
                          "quant": quant[0], "files": quant[1], "size": quant[2]})
    return picks[:count]


# ---- the list ----

def entries(values, router):
    """The models on this Thor: listed by the router first, then the rest on disk."""
    served = router.models()
    disk = on_disk()
    default = model_id(values["MODEL"])
    rows = []
    for name, state in sorted(served.items(), key=lambda item: item[0] != default):
        path = disk.get(name) or Path(values["MODEL"])
        rows.append({"id": name, "state": state, "size": size_of(path) if path.exists() else 0,
                     "note": "default (nemotron)" if name == default else ""})
    for name, path in disk.items():
        if name not in served:
            rows.append({"id": name, "state": "on disk", "size": size_of(path), "path": path, "note": ""})
    return rows


def downloadable(values):
    """The newest models on Hugging Face, as rows."""
    print("asking Hugging Face for the newest models…", flush=True)
    room = (free_gb() - int(values["MIN_FREE_GB"]) - WORKING_GB) * 1e9
    return [{"id": model_id(pick["files"][0]), "state": "on Hugging Face", "size": pick["size"], "pick": pick,
             "note": f"{pick['date']} · {pick['licence']} · {pick['repo']}"
                     + ("" if pick["size"] <= room else " · fits only after unloading the default")}
            for pick in latest(values)]


def show(rows, values):
    print(f"\nThor: {free_gb():.1f} GB free of {total_gb():.1f} GB · keeps {values['MIN_FREE_GB']} GB free"
          f" · at most {values['MODELS_MAX']} models loaded\n")
    print(f"  {'key':<4} {'model':<46} {'state':<16} {'size':>9}  ")
    for key, row in enumerate(rows, 1):
        print(f"  {key:<4} {label(row['id'])[:46]:<46} {row['state']:<16} {gb(row['size']):>9}  {row['note']}")
    print()


def room_for(size, values, router):
    """None if a model of `size` bytes can be loaded now, else the reason it can't."""
    loaded = [name for name, state in router.models().items() if state in ("loaded", "loading")]
    if len(loaded) >= int(values["MODELS_MAX"]):
        return f"{len(loaded)} loaded already, the most at once is {values['MODELS_MAX']} (MODELS_MAX); unload one first"
    needed = size / 1e9 + WORKING_GB
    room = max(0.0, free_gb() - int(values["MIN_FREE_GB"]))
    if needed > room:
        return f"needs about {needed:.0f} GB, only {room:.0f} GB can be used while keeping {values['MIN_FREE_GB']} GB free"
    return None


def load(row, values, router):
    """Lists the model if it is only on disk, loads it, and commits its memory with one token.
    Memory on the Thor is committed on first use, so the first reply is watched too."""
    if row["state"] in ("loaded", "loading"):
        return print("already loaded")
    reason = room_for(row["size"], values, router)
    if reason:
        return print(f"not loaded: {reason}")
    if row["state"] == "on disk":
        add_from_disk(row["path"])
        router.reload(values)
    minimum = int(values["MIN_FREE_GB"])
    started = time.time()
    router.call("POST", "/models/load", {"model": row["id"]})
    while (state := router.models().get(row["id"])) != "loaded":
        if state == "failed":
            return print("failed to load; see: journalctl --user -u thor-chat -n 50")
        if free_gb() < minimum:
            router.call("POST", "/models/unload", {"model": row["id"]})
            return print(f"free memory fell below {minimum} GB while loading; unloaded again")
        time.sleep(1)
    print(f"loaded in {time.time() - started:.0f} s; sending one token to commit its memory")
    with concurrent.futures.ThreadPoolExecutor(1) as pool:
        warmup = pool.submit(router.call, "POST", "/v1/chat/completions",
                             {"model": row["id"], "max_tokens": 1, "messages": [{"role": "user", "content": "hi"}]}, 300)
        while not warmup.done():
            if free_gb() < minimum:
                router.call("POST", "/models/unload", {"model": row["id"]})
                return print(f"free memory fell below {minimum} GB on the first reply; unloaded again")
            time.sleep(0.5)
    print(f"ready: {free_gb():.1f} GB free")


def unload(row, values, router):
    """Frees a model's memory. A model added from disk also leaves the list, so
    the chat page stops offering it; it shows as "on disk" again."""
    if row["state"] == "on disk":
        return print("not loaded")
    if row["id"] == model_id(values["MODEL"]):
        try:
            answer = input("This is the default model: the chat stops answering until it is loaded again. Unload? [y/N] ")
        except EOFError:
            answer = ""
        if answer.strip().lower() != "y":
            return
    before = free_gb()
    if row["state"] in ("loaded", "loading"):
        router.call("POST", "/models/unload", {"model": row["id"]})
        while router.models().get(row["id"]) not in ("unloaded", "failed"):
            time.sleep(1)
        time.sleep(2)
        print(f"unloaded: {free_gb() - before:.1f} GB freed, {free_gb():.1f} GB free")
    if row["id"] in local_sections():
        remove_from_list(row["id"])
        router.reload(values)
        print("off the chat page's list; still on disk")


def download(row, values, router):
    pick = row["pick"]
    folder = MODELS_DIR / pick["repo"].split("/")[1].removesuffix("-GGUF")
    folder.mkdir(parents=True, exist_ok=True)
    for file in pick["files"]:
        target = folder / Path(file).name
        print(f"downloading {file} into {folder}")
        url = f"https://huggingface.co/{pick['repo']}/resolve/main/{file}"
        if subprocess.run(["curl", "-L", "-C", "-", "--fail", "--progress-bar", "-o", str(target), url]).returncode:
            return print("download failed; run the same action again to resume")
    print(f"downloaded {gb(pick['size'])}; see thor-tigress-serve list, then load it")


def find(rows, wanted, command):
    """The row a key ("2") or a name (id, alias or repository) points to."""
    if wanted.isdigit() and 1 <= int(wanted) <= len(rows):
        return rows[int(wanted) - 1]
    for row in rows:
        names = {row["id"].lower(), row.get("pick", {}).get("repo", "").lower()}
        if wanted.lower() in names:
            return row
    sys.exit(f"no model {wanted!r}; see thor-tigress-serve {command}")


def list_here(values):
    show(entries(values, Router(values)), values)


def list_latest(values):
    rows = downloadable(values)
    LATEST.parent.mkdir(parents=True, exist_ok=True)
    LATEST.write_text(json.dumps(rows))
    show(rows, values)


def act(action, values, wanted, command):
    router = Router(values)
    try:
        action(find(entries(values, router), wanted, command), values, router)
    except (urllib.error.URLError, TimeoutError) as error:
        sys.exit(f"the model server said: {error}")


def load_command(values, wanted):
    act(load, values, wanted, "list")


def unload_command(values, wanted):
    act(unload, values, wanted, "list")


def download_command(values, wanted):
    if not LATEST.exists():
        sys.exit("run thor-tigress-serve list-latest first")
    download(find(json.loads(LATEST.read_text()), wanted, "list-latest"), values, None)


# ---- services ----

def run(values):
    CONFIG.mkdir(parents=True, exist_ok=True)
    (CONFIG / "models.ini").write_text(presets(values))
    key = CONFIG / "api-key"
    arguments = [values["SERVER"], "--models-preset", str(CONFIG / "models.ini"), "--models-max", values["MODELS_MAX"],
                 "--host", "127.0.0.1", "--port", values["MODEL_PORT"]]
    if key.exists() and key.stat().st_size:
        arguments += ["--api-key-file", str(key)]
    os.execv(values["SERVER"], arguments)


def agent(values):
    os.execv(values["AGENT"], [values["AGENT"], "--listen", f"127.0.0.1:{values['PORT']}",
                               "--model", f"127.0.0.1:{values['MODEL_PORT']}", "--search", f"127.0.0.1:{values['SEARCH_PORT']}",
                               "--web", str(WEB), "--key-file", str(CONFIG / "api-key")])


def unit(name, description, command, after):
    (UNITS / f"{name}.service").write_text(f"""[Unit]
Description={description}
After=network-online.target {after}

[Service]
ExecStart={Path(__file__).resolve()} {command}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
""")


def install(values):
    UNITS.mkdir(parents=True, exist_ok=True)
    unit("thor-chat", f"Models (llama-server) on 127.0.0.1:{values['MODEL_PORT']}", "run", "")
    unit("thor-tigress-agent", f"Chat page and web search on 127.0.0.1:{values['PORT']}", "agent", "thor-chat.service")
    command = HOME / ".local" / "bin" / "thor-tigress-serve"
    command.parent.mkdir(parents=True, exist_ok=True)
    command.unlink(missing_ok=True)
    command.symlink_to(Path(__file__).resolve())
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    subprocess.run(["systemctl", "--user", "enable", "thor-chat", "thor-tigress-agent"], check=True, capture_output=True)
    subprocess.run(["systemctl", "--user", "restart", "thor-chat", "thor-tigress-agent"], check=True)
    subprocess.run(["loginctl", "enable-linger", os.environ.get("USER", "")], check=False)
    print(f"running; both start at boot. {command} is on your PATH.")


def uninstall(values):
    subprocess.run(["systemctl", "--user", "disable", "--now", "thor-tigress-agent", "thor-chat"], check=False)
    for name in ("thor-chat", "thor-tigress-agent"):
        (UNITS / f"{name}.service").unlink(missing_ok=True)
    subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
    print("stopped and removed")


def key(values):
    CONFIG.mkdir(parents=True, exist_ok=True)
    path = CONFIG / "api-key"
    path.write_text(os.urandom(24).hex() + "\n")
    path.chmod(0o600)
    print(f"new key written to {path}\napply it: systemctl --user restart thor-chat thor-tigress-agent")


def logs(values):
    os.execvp("journalctl", ["journalctl", "--user", "-u", "thor-chat", "-u", "thor-tigress-agent", "-f"])


COMMANDS = {
    "list": list_here, "list-latest": list_latest,
    "install": install, "uninstall": uninstall, "key": key, "logs": logs, "run": run, "agent": agent,
}
COMMANDS_WITH_NAME = {"load": load_command, "unload": unload_command, "download": download_command}


def main():
    values = settings()
    command, *rest = sys.argv[1:] or ["help"]
    if command in COMMANDS and not rest:
        return COMMANDS[command](values)
    if command in COMMANDS_WITH_NAME and len(rest) == 1:
        return COMMANDS_WITH_NAME[command](values, rest[0])
    print(__doc__)
    return None if command in ("help", "-h", "--help") else sys.exit(2)


if __name__ == "__main__":
    main()
