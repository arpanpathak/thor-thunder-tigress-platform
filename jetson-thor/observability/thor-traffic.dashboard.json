            {
              "query": "SELECT histogram(_timestamp, '1 minute') AS \"x_axis_1\", model AS \"breakdown_1\", count(*) AS \"y_axis_1\" FROM \"requests\" GROUP BY x_axis_1, breakdown_1 ORDER BY x_axis_1",
