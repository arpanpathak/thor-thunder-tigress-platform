        {
          "id": "panel_6",
          "type": "line",
          "title": "Output tokens per second, by model",
          "description": "Answer tokens over the time spent writing them, first byte to last; only streamed answers",
          "config": {
            "show_legends": true,
            "legends_position": "bottom"
          },
          "queryType": "sql",
          "queries": [
            {
              "query": "SELECT histogram(_timestamp, '1 minute') AS \"x_axis_1\", model AS \"breakdown_1\", sum(output_tokens) * 1000.0 / sum(total_ms - first_byte_ms) AS \"y_axis_1\" FROM \"requests\" WHERE limited = false AND output_tokens > 0 AND total_ms > first_byte_ms GROUP BY x_axis_1, breakdown_1 ORDER BY x_axis_1",
              "customQuery": true,
              "fields": {
                "stream": "requests",
                "stream_type": "logs",
                "x": [
                  {
                    "label": "Time",
                    "alias": "x_axis_1",
                    "column": "x_axis_1",
                    "color": null,
                    "type": "custom"
                  }
                ],
                "y": [
                  {
                    "label": "Tokens/s",
                    "alias": "y_axis_1",
                    "column": "y_axis_1",
                    "color": null,
                    "type": "custom"
                  }
                ],
                "z": [],
                "breakdown": [
                  {
                    "label": "Model",
                    "alias": "breakdown_1",
                    "column": "breakdown_1",
                    "color": null,
                    "type": "custom"
                  }
                ],
                "filter": {
                  "filterType": "group",
                  "logicalOperator": "AND",
                  "conditions": []
                }
              },
              "config": {
                "promql_legend": ""
              }
            }
